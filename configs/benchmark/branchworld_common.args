--model BranchWorldModel
--wm_latent_dim 128
--wm_branch_num 3
--wm_retrieve_k 64
--wm_memory_size 4096
--wm_global_proto_num 32
--wm_kmeans_iters 8
--wm_proto_state_alpha 1.0
--wm_proto_traj_beta 2.0
--wm_backbone patch_transformer
--wm_patch_len 16
--wm_patch_stride 8
--wm_memory_update_freq 1
--wm_memory_warmup_epochs 0
--wm_base_model dlinear
--wm_base_type dlinear
--wm_freeze_base 1
--wm_mem_loss_type min
--wm_mem_weight 0.1
--wm_residual_context_weight 0.01
--wm_alpha_weight 0.01
--wm_confidence_weight 0.05
--wm_confidence_temperature 0.02
--wm_alpha_max 0.3
--wm_alpha_reliability_power 1.0
--wm_branch_temperature 1.0
--wm_branch_dropout 0.1
--wm_correction_scale 1.0
--wm_conflict_weight 0.01
--wm_delta_clamp 3.0
