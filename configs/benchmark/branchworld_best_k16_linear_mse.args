--model BranchWorldModel
--wm_latent_dim 64
--wm_memory_size 4096
--wm_global_proto_num 16
--wm_kmeans_iters 8
--wm_backbone temporal_transformer
--wm_patch_len 16
--wm_patch_stride 8
--wm_memory_update_freq 1
--wm_memory_warmup_epochs 0
--wm_attention_mode linear
--wm_base_model dlinear
--wm_base_type dlinear
--wm_freeze_base 1
--wm_freeze_encoder 1
--wm_correction_lambda 0.1
--wm_predictor_loss mse
--wm_predictor_checkpoint ""
--wm_predictor_ce_weight 1.0
--wm_predictor_ce_only 0
--wm_predictor_entropy_weight 0.0
--wm_predictor_context z0
--wm_predictor_type linear
--wm_predictor_hidden_dim 128
--wm_residual_encoder identity
--wm_residual_latent_dim 64
--wm_residual_hidden_dim 128
--wm_hard_selection 0
--wm_branch_temperature 1.0
--wm_delta_clamp 3.0
